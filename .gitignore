# ==========================================
# GestureForge - .gitignore
# Python, Node.js, Frontend, Datasets & IDEs
# ==========================================

# Environment Variables
.env
.env.local
.env.*.local
*.env

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Node.js & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Machine Learning & Large Artifacts
*.h5
*.pkl
*.joblib
*.onnx
*.pt
*.pth
*.tflite
dataset/raw/*.mp4
dataset/raw/*.avi
dataset/raw/*.mov
dataset/processed/*.npy
dataset/processed/*.npz
!dataset/raw/.gitkeep
!dataset/processed/.gitkeep

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Settings
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# Logs
logs/
*.log
